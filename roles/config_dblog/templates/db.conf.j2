## for MariaDB
####################################################################################
{% if config_dblog_db_config.type == "mariadb" %}
%dbconfig= (
{% if config_dblog_db_config.host | string | length and config_dblog_db_config.host | type_debug != 'NoneType' %}
    connection => "MariaDB:database={{ config_dblog_db_config.database }};host={{ config_dblog_db_config.host }};port={{ config_dblog_db_config.port }}",
{% else %}
    # connection => "MariaDB:database=fhem;host=<database host>;port=3306",
{% endif %}
    # if want communication over socket-file instead of TCP/IP transport, use:
{% if config_dblog_db_config.socket | string | length and config_dblog_db_config.socket | type_debug != 'NoneType' %}
    connection => "MariaDB:database={{ config_dblog_db_config.database }};mariadb_socket={{ config_dblog_db_config.socket }}",
{% else %}
    # connection => "MariaDB:database=fhem;mariadb_socket=</path/socket-file>",
{% endif %}
    user => "{{ config_dblog_db_config.user }}",
    password => "{{ config_dblog_db_config.password }}",
    # optional enable communication compression between client and server
{% if config_dblog_db_config.compression | bool == true %}
    compression => 1 
{% else %}
    # compression => 1 
{% endif %}
);
{% else %}
#%dbconfig= (
