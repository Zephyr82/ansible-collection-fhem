#    compression => 1 
#);
{% endif %}
####################################################################################
#
## for PostgreSQL
####################################################################################
{% if config_dblog_db_config.type == "postgresql" %}
%dbconfig= (
    connection => "Pg:database={{ config_dblog_db_config.database }};host={{ config_dblog_db_config.host }}",
    user => "{{ config_dblog_db_config.user }}",
    password => "{{ config_dblog_db_config.password }}"
);
{% else %}
#%dbconfig= (
#    connection => "Pg:database=fhem;host=<database host>",
#    user => "fhemuser",
#    password => "fhempassword"
#);
{% endif %}
####################################################################################
#
## for SQLite (username and password stay empty for SQLite)
####################################################################################
{% if config_dblog_db_config.type == "sqlite" %}
%dbconfig= (
    connection => "SQLite:dbname={{ config_dblog_db_config.database }}",
    user => "",
    password => ""
);
{% else %}
#%dbconfig= (
#    connection => "SQLite:dbname=/opt/fhem/fhem.db",
#    user => "",
#    password => ""
#);
{% endif %}
